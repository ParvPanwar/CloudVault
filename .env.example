AWS_REGION=ap-southeast-2
RAW_BUCKET=cloudvault-raw-REPLACE-WITH-UNIQUE-ID
PROCESSED_BUCKET=cloudvault-processed-REPLACE-WITH-UNIQUE-ID
QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/ACCOUNT_ID/cloudvault-job-queue
FILES_TABLE=CloudVault_Files
USER_FILES_TABLE=CloudVault_UserFiles
# Generate each token with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# These are application tenant tokens, NOT AWS access keys. Replace every placeholder.
TENANT_TOKENS={"alice":"REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARS","bob":"REPLACE_WITH_ANOTHER_RANDOM_TOKEN_AT_LEAST_32_CHARS"}
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_BYTES=52428800
# Use your local AWS CLI profile, or an EC2 instance role on AWS. Never commit AWS credentials.
